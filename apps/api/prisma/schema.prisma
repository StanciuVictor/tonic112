// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// isAdmin and canCreateParty are independent capability flags, not a role
// hierarchy — neither implies the other (see architecture-and-product-spec.md
// Section 2). Both are granted out-of-band (direct DB edit) in v1; there is
// no self-elevation endpoint by design.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  isAdmin        Boolean  @default(false)
  canCreateParty Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdParties   Party[]
  partyMemberships PartyMember[]
}

enum PartyStatus {
  active
  ended
}

enum PartyMemberRole {
  customer
  bartender
}

// code is the short, human-readable backup code (typed manually); qrToken is
// a separate, longer, unguessable value embedded in the QR's join URL. Both
// resolve the same party via GET /parties/:code, which matches either field —
// see .docs/04-epic-party-join-flow.md for why the endpoint stays singular.
model Party {
  id              String      @id @default(cuid())
  code            String      @unique
  qrToken         String      @unique
  status          PartyStatus @default(active)
  createdByUserId String
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())
  startedAt       DateTime    @default(now())
  endedAt         DateTime?

  members PartyMember[]
  guests  PartyGuest[]
}

// One row per (partyId, userId) pair — every registered participant, not
// just bartenders. Promotion (Epic 05) is just this row's role flipping.
model PartyMember {
  id         String          @id @default(cuid())
  partyId    String
  party      Party           @relation(fields: [partyId], references: [id])
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  role       PartyMemberRole @default(customer)
  joinedAt   DateTime        @default(now())
  promotedAt DateTime?

  @@unique([partyId, userId])
}

// Fully ephemeral — never linked to a User, never gets a PartyMember row.
model PartyGuest {
  id         String   @id @default(cuid())
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id])
  guestName  String
  createdAt  DateTime @default(now())
}

// Small, fixed, developer-defined taxonomy (see architecture-and-product-spec.md
// Section 4) — translates through the static UI-string mechanism (Epic 11),
// not per-row bilingual data like Ingredient.name.
enum DrinkCategory {
  cocktail
  mocktail
  shot
  beer
  wine
  champagne
  spirit
  liqueur
  non_alcoholic
  hot_drink
}

// name is never translated, in any mechanism — cocktail names stay as-is
// regardless of UI language. price is reserved but unused in v1 (no billing
// yet — see architecture-and-product-spec.md Section 12/15).
model Drink {
  id          String        @id @default(cuid())
  name        String
  description String
  category    DrinkCategory
  imageUrl    String?
  active      Boolean       @default(true)
  price       Decimal?      @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  recipe DrinkIngredient[]
}

// name is a translated JSON object ({ en, ro }), not a static-file lookup
// key, since ingredients are managed dynamically through the admin panel.
// currentStock is a v2 field — do not add it now (Section 16).
model Ingredient {
  id        String   @id @default(cuid())
  name      Json
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedIn DrinkIngredient[]
}

// One recipe line: how much of one ingredient a drink needs, plus the
// per-step instructions for that ingredient within that drink's recipe —
// also translated JSON ({ en, ro }), same rationale as Ingredient.name.
model DrinkIngredient {
  id           String     @id @default(cuid())
  drinkId      String
  drink        Drink      @relation(fields: [drinkId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float
  instructions Json
  createdAt    DateTime   @default(now())

  @@unique([drinkId, ingredientId])
}
