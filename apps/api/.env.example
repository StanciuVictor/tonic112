# Copy to .env for local development.
# These are dev-default (non-secret) credentials matching docker-compose.yml.
DATABASE_URL="postgresql://user:password@host:port/dbname?param=value"
WEB_BASE_URL="http://localhost:8081"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="30d"
GUEST_JWT_EXPIRES_IN="12h"
